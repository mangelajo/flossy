# Copia este fichero a .env y ajústalo; luego: docker compose up -d --build
#
# Prueba local en la propia máquina: http://localhost:8080
RP_ID=localhost
ORIGIN=http://localhost:8080
WEB_PORT=8080
RP_NAME=flossy

# Despliegue real: la cámara del móvil y las passkeys EXIGEN HTTPS. Pon flossy detrás de un
# proxy/túnel con TLS para tu dominio (Caddy, Traefik, Cloudflare Tunnel, Tailscale Serve…):
#   RP_ID=flossy.example.com
#   ORIGIN=https://flossy.example.com

# El primer perfil creado es administrador (por defecto). Para exigir código de invitación
# a los siguientes (se generan en Ajustes):
#   INVITE_ONLY=1
#
# Acceso con nombre + contraseña además de passkeys (por defecto activado, útil para
# tablets o navegadores de los niños sin passkeys):
#   PASSWORD_LOGIN=1
#
# Duración de la sesión en días (por defecto 180):
#   SESSION_DAYS=180
