# Opcional: copia este fichero a .env para cambiar algo. Sin .env, `docker compose up -d` sirve
# flossy en http://localhost:8080 para usarlo en esta misma máquina.
#
# RP_ID=localhost
# ORIGIN=http://localhost:8080
# WEB_PORT=8080
# RP_NAME=flossy
# FLOSSY_TAG=latest              # versión de las imágenes de ghcr.io (latest, 1.2.0, sha-abc1234…)

# Despliegue real: la cámara del móvil y las passkeys EXIGEN HTTPS. Pon flossy detrás de un
# proxy/túnel con TLS para tu dominio (Caddy, Traefik, Cloudflare Tunnel, Tailscale Serve…):
#   RP_ID=flossy.example.com
#   ORIGIN=https://flossy.example.com
#
# Prueba rápida desde el móvil en la red de casa (perfil https, certificado autofirmado):
#   docker compose --profile https up -d
#   RP_ID=192.168.1.50
#   ORIGIN=https://192.168.1.50:8443

# El primer perfil creado es administrador. Para exigir código de invitación a los demás
# (se generan en Ajustes → Invitaciones):
#   INVITE_ONLY=1
#
# Acceso con nombre + contraseña además de passkeys (activado por defecto; útil para tablets
# o navegadores de los niños sin passkeys). Para desactivarlo:
#   PASSWORD_LOGIN=0
#
# Duración de la sesión en días (por defecto 180):
#   SESSION_DAYS=180
